{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard", ":semanticCommitsDisabled", "helpers:pinGitHubActionDigestsToSemver"],
  "schedule": ["before 6am on monday"],
  "timezone": "Europe/Berlin",
  "packageRules": [
    { "matchUpdateTypes": ["minor", "patch", "pin", "digest"], "groupName": "all non-major dependencies", "groupSlug": "all-minor-patch" }
  ],
  "vulnerabilityAlerts": { "enabled": true, "schedule": ["at any time"] }
}
